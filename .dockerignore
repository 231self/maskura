# Keep host build artifacts and VCS metadata out of the image build context.
# Without this, COPY . . ships the host's target/ (runner-built binaries),
# which then get copied into the image instead of freshly compiled ones.
target
.git
.jj
.worktrees
node_modules
__pycache__
*.py[cod]
docs/output
sdks/typescript/dist
.actrc
act
.env
*.env.resolved
