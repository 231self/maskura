ields; `s3_compatible` needs `endpoint`, `access_key`, `secret_key`,\nand `region`.","required":["backend_type"],"properties":{"access_key":{"type":"string"},"backend_type":{"$ref":"#/components/schemas/BackendType"},"endpoint":{"type":"string"},"external_id":{"type":["string","null"]},"region":{"type":"string"},"role_arn":{"type":"string"},"secret_key":{"type":"string"}},"additionalProperties":false},"BackendConfigResponse":{"type":"object","description":"Redacted dashboard representation. Credential material is intentionally\nabsent from this type, so a GET cannot serialize it by mistake. Its exact\nJSON keys are `configured`, `backend_type`, `endpoint`, `region`,\n`role_arn`, `external_id`, `access_key_configured`, and\n`secret_key_configured`. `external_id` is not a secret: it is the\nconfused-deputy-prevention correlation value an operator pastes into the\nrole trust policy.","required":["configured","access_key_configured","secret_key_configured"],"properties":{"access_key_configured":{"type":"boolean"},"backend_type":{"oneOf":[{"type":"null"},{"$ref":"#/components/schemas/BackendType"}]},"configured":{"type":"boolean"},"endpoint":{"type":["string","null"]},"external_id":{"type":["string","null"]},"region":{"type":["string","null"]},"role_arn":{"type":["string","null"]},"secret_key_configured":{"type":"boolean"}}},"BackendType":{"type":"string","enum":["s3_compatible","aws_role","managed"]},"CreateKeyRequest":{"type":"object","required":["label"],"properties":{"expires_in":{"type":"integer","format":"int64","minimum":0},"label":{"type":"string"},"public_key_pem":{"type":["string","null"]}}},"CreateMcpTokenRequest":{"type":"object","required":["label"],"properties":{"expires_in":{"type":"integer","format":"int64","minimum":0},"label":{"type":"string"}}},"DeleteKeyRequest":{"type":"object","required":["key_id"],"properties":{"key_id":{"type":"string"}}},"DeleteMcpTokenRequest":{"type":"object","required":["token_hash"],"properties":{"token_hash":{"type":"string"