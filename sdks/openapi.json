{"openapi":"3.1.0","info":{"title":"Maskura Gateway API","description":"Pluggable processing gateway for S3-compatible storage. Manage plugins and API keys, proxy S3 requests through a Wasm plugin pipeline.","license":{"name":"Apache-2.0","identifier":"Apache-2.0"},"version":"0.7.2"},"paths":{"/dashboard/api/backend":{"get":{"tags":["backend"],"operationId":"get_backend","responses":{"200":{"description":"Redacted workspace backend configuration","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BackendConfigResponse"}}}},"401":{"description":"Not authenticated"}}},"put":{"tags":["backend"],"operationId":"put_backend","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BackendConfigRequest"}}},"required":true},"responses":{"200":{"description":"Redacted saved workspace backend configuration","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BackendConfigResponse"}}}},"400":{"description":"Incomplete or unsupported configuration"},"401":{"description":"A real authenticated user is required"}}}},"/dashboard/api/keys":{"get":{"tags":["keys"],"summary":"List API keys for the authenticated user","operationId":"get_keys","responses":{"200":{"description":"API keys","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ListKeyResponse"}}}}}}},"post":{"tags":["keys"],"summary":"Create a new API key","operationId":"create_key","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateKeyRequest"}}},"required":true},"responses":{"200":{"description":"Created key with secret","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyResponse"}}}}}},"delete":{"tags":["keys"],"summary":"Revoke an API key","operationId":"delete_key","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeleteKeyRequest"}}},"required":true},"responses":{"204":{"description":"Key revoked"},"404":{"descripti